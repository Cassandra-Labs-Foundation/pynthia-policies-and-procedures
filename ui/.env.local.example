# Copy to ui/.env.local (gitignored) and fill in.
#
# Neither name carries the NEXT_PUBLIC_ prefix, and neither may. That prefix is
# what tells Next.js to inline a value into the client bundle — CORE_API_KEY is
# a bearer credential for the whole banking core, so it is read only in
# src/lib/coreApi.js, which runs server-side behind the proxy route.

CORE_API_URL=https://jynsipdvrgqdkeqrlzcv.functions.supabase.co/api

# The DEMO_API_KEY value from the repo-root .env.local
CORE_API_KEY=
